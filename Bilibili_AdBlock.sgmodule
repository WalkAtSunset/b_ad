#!name = Bilibili 去广告 & 净化
#!desc = 去除开屏广告、信息流广告、视频广告、"新征程"Tab、"会员购"Tab、游戏中心图标
#!system = ios
#!version = 1.2.0
#!author = Claude
#!homepage = https://github.com/
#!icon = https://i0.hdslb.com/bfs/app-favicon/f6b99470-e52a-4e9b-8fcf-c3c07f4bb0a9.png

# ============================================================
# 使用说明：
# 1. 将本 .sgmodule 及所有 .js 脚本文件上传到同一 GitHub 仓库
# 2. 将下方所有 script-path 中的 <RAW_URL> 替换为你的 GitHub Raw 地址
#    示例: https://raw.githubusercontent.com/你的用户名/仓库名/main/
# 3. 在 Shadowrocket → 模块 → 右上角"+" → 粘贴 .sgmodule 的 Raw URL
# 4. 确保 HTTPS 解密(MitM)已开启，并信任证书
# ============================================================

[MITM]
hostname = app.bilibili.com, api.bilibili.com, api.live.bilibili.com, app.biliapi.net, grpc.biliapi.net, passport.bilibili.com, *.bilibili.com, *.hdslb.com

# ============================================================
# URL 重写：直接拦截广告接口，返回空响应
# ============================================================
[URL Rewrite]
# 开屏广告
^https?://app\.bilibili\.com/x/v2/splash/(list|brand/list) reject-200
^https?://app\.biliapi\.net/x/v2/splash/(list|brand/list) reject-200

# 活动/运营弹窗广告
^https?://app\.bilibili\.com/x/v2/account/realname/pop reject-200
^https?://app\.bilibili\.com/x/v2/show/pre-roll-ad reject-200

# 数据上报（减少隐私泄露）
^https?://data\.bilibili\.com/log/ reject-200
^https?://api\.bilibili\.com/x/report/click reject-200
^https?://app\.bilibili\.com/x/v2/report reject-200

# 热门/广告活动页
^https?://api\.bilibili\.com/x/web-interface/popular/series/card reject-200

# ============================================================
# 脚本规则
# ============================================================
[Script]

# --- 信息流广告过滤（首页推荐 & 热门）---
bilibili_feed_rcmd = type=http-response,\
  pattern=^https?://app\.bilibili\.com/x/(v2/feed/index|feed/rcmd),\
  requires-body=1,\
  max-size=-1,\
  timeout=60,\
  script-path=https://raw.githubusercontent.com/WalkAtSunset/b_ad/refs/heads/main/bilibili_feed.js,\
  script-update-interval=0

# --- 搜索结果广告过滤 ---
bilibili_search = type=http-response,\
  pattern=^https?://app\.bilibili\.com/x/v2/search,\
  requires-body=1,\
  max-size=-1,\
  timeout=60,\
  script-path=<RAW_URL>bilibili_feed.js,\
  script-update-interval=0

# --- 底部导航 & 顶部 Tab 净化（去除"会员购"、"新征程"、游戏中心图标）---
bilibili_nav = type=http-response,\
  pattern=^https?://app\.bilibili\.com/x/v2/(navigation|tab-management|main/tab),\
  requires-body=1,\
  max-size=-1,\
  timeout=60,\
  script-path=https://raw.githubusercontent.com/WalkAtSunset/b_ad/refs/heads/main/bilibili_nav.js,\
  script-update-interval=0

# --- 首页顶部 Banner & 活动卡片过滤 ---
bilibili_home = type=http-response,\
  pattern=^https?://app\.bilibili\.com/x/v2/(account/myinfo|acc/info|dynamic/feed|dynamic/region),\
  requires-body=1,\
  max-size=-1,\
  timeout=60,\
  script-path=https://raw.githubusercontent.com/WalkAtSunset/b_ad/refs/heads/main/bilibili_feed.js,\
  script-update-interval=0

# --- 视频播放页广告过滤 ---
bilibili_video_ad = type=http-response,\
  pattern=^https?://api\.bilibili\.com/x/v2/view,\
  requires-body=1,\
  max-size=-1,\
  timeout=60,\
  script-path=https://raw.githubusercontent.com/WalkAtSunset/b_ad/refs/heads/main/bilibili_video.js,\
  script-update-interval=0

# --- gRPC 接口广告过滤（新版客户端）---
bilibili_grpc = type=http-response,\
  pattern=^https?://grpc\.biliapi\.net/bilibili\.app\.playerunite\.v1\.Player/PlayViewUnite,\
  requires-body=1,\
  max-size=-1,\
  timeout=60,\
  binary-body-mode=1,\
  script-path=https://raw.githubusercontent.com/WalkAtSunset/b_ad/refs/heads/main/bilibili_grpc.js,\
  script-update-interval=0
